# SiliconFlow API 配置
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2
SILICONFLOW_TIMEOUT_SECONDS=45

# 访问鉴权（可选，纵深防御）。留空则不鉴权（本地开发）；
# 公网暴露时建议设置 TASK_GANTT_AUTH_TOKEN，浏览器会弹出 Basic Auth 登录框。
TASK_GANTT_AUTH_USER=admin
TASK_GANTT_AUTH_TOKEN=

# 是否信任反向代理（FRP）注入的 X-Forwarded-For 来识别客户端 IP（用于限流）。
# 直接对外暴露（无代理）时设为 false。
TASK_GANTT_TRUST_PROXY=true

# LLM 后台任务并发数（智能拆解/会议更新在后台线程池执行）。
TASK_GANTT_LLM_WORKERS=3
